generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum TravelEnvironment {
  SEA
  MOUNTAINS
  VINEYARDS
  CITY
}

enum CuisineStyle {
  TRADITION
  CREATIVITY
  ECO
}

enum TravelStyle {
  GASTRONOMIC
  ADVENTURE
  CULTURE
  ROMANCE
}

enum TravelPace {
  SLOW
  ROADTRIP
}

enum TripDuration {
  ONE_NIGHT
  SHORT_BREAK
  ONE_WEEK
  EXTENDED
}

enum BudgetTier {
  DISCOVERY
  EXCELLENCE
  PRESTIGE
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  pseudo        String    @unique
  passwordHash  String
  lastName      String
  firstName     String
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  role          Role        @default(USER)
  restaurants   Restaurant[]
  articles    Article[]
  profile       UserProfile?

  @@map("users")
}

model UserProfile {
  id                    String              @id @default(uuid())
  userId                String              @unique
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  age                   Int?
  environments          TravelEnvironment[]
  cuisines              CuisineStyle[]
  travelStyle           TravelStyle?
  travelPace            TravelPace?
  tripDuration          TripDuration?
  budgetPerNight        Int?
  budgetTier            BudgetTier?
  onboardingCompletedAt DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@map("user_profiles")
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String   @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  revokedAt        DateTime?

  @@index([userId])
  @@map("sessions")
}
model Restaurant {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  name        String
  description String
  address     String
  videoUrl    String?

  // --- Fiche Michelin ---
  chefName    String?
  stars       Int?      // 0..3 (null = non attribuee / Bib / Recommande)
  priceRange  String?   // "EUR" | "EUREUR" | "EUREUREUR" | "EUREUREUREUR"
  style       String[]  @default([]) // ex: ["Gastronomie", "Vignes"]

  // --- Visite 3D ---
  tourStops   Json?     // cf. lib/restaurants/tour-stops.ts
  photos360   String[]  @default([]) // URLs optionnelles pour textures murs

  owner       User      @relation(fields: [ownerId], references: [id])
  ownerId     String
  articles    Article[]

  @@map("restaurants")
}

model Article {
  id           String     @id @default(cuid())
  title        String
  content      String
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String
  author       User       @relation(fields: [authorId], references: [id])
  authorId     String

  @@map("articles")
}