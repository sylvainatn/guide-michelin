generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum TravelEnvironment {
  SEA
  MOUNTAINS
  VINEYARDS
  CITY
}

enum CuisineStyle {
  TRADITION
  CREATIVITY
  ECO
}

enum TravelStyle {
  GASTRONOMIC
  ADVENTURE
  CULTURE
  ROMANCE
}

enum TravelPace {
  SLOW
  ROADTRIP
}

enum TripDuration {
  ONE_NIGHT
  SHORT_BREAK
  ONE_WEEK
  EXTENDED
}

enum BudgetTier {
  DISCOVERY
  EXCELLENCE
  PRESTIGE
}

enum CardBrand {
  VISA
  MASTERCARD
  CARD
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum ReservationPaymentMethod {
  APPLE_PAY
  GOOGLE_PAY
  CARD
}

enum ReservationEventType {
  MARIAGE
  EVJF
  ANNIVERSAIRE
  SAINT_VALENTIN
}
enum AccommodationCategory {
  HOTEL
  BED_AND_BREAKFAST
  CHALET
  VILLA
  APARTMENT
  RESORT
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  pseudo        String    @unique
  passwordHash  String
  lastName      String
  firstName     String
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  role          Role        @default(USER)
  restaurants   Restaurant[]
  articles      Article[]
  profile       UserProfile?
  bookmarks     Bookmark[]
  favorites     Favorite[]
  paymentCards  PaymentCard[]
  reservations  Reservation[]
  accommodations Accommodation[]

  @@map("users")
}

model UserProfile {
  id                    String              @id @default(uuid())
  userId                String              @unique
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  age                   Int?
  environments          TravelEnvironment[]
  cuisines              CuisineStyle[]
  travelStyle           TravelStyle?
  travelPace            TravelPace?
  tripDuration          TripDuration?
  budgetPerNight        Int?
  budgetTier            BudgetTier?
  onboardingCompletedAt DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@map("user_profiles")
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String   @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  revokedAt        DateTime?

  @@index([userId])
  @@map("sessions")
}
model Restaurant {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  name          String
  description   String
  address       String
  videoUrl      String?
  mainImageUrl  String?

  // --- Fiche Michelin ---
  chefName    String?
  stars       Int?      // 0..3 (null = non attribuee / Bib / Recommande)
  priceRange  String?   // "EUR" | "EUREUR" | "EUREUREUR" | "EUREUREUREUR"
  style       String[]  @default([]) // ex: ["Gastronomie", "Vignes"]

  // --- Visite 3D ---
  tourStops   Json?     // cf. lib/restaurants/tour-stops.ts
  photos360   String[]  @default([]) // URLs optionnelles pour textures murs

  owner       User      @relation(fields: [ownerId], references: [id])
  ownerId     String
  articles    Article[]
  bookmarks   Bookmark[]
  favorites   Favorite[]
  review      MichelinReview?
  reservations Reservation[]

  @@map("restaurants")
}

model MichelinReview {
  id                String     @id @default(cuid())
  restaurantId      String     @unique
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  // Les 5 criteres mondiaux (0.0 -> 10.0)
  productsScore     Float
  harmonyScore      Float
  masteryScore      Float
  personalityScore  Float
  regularityScore   Float

  // Contexte editorial affiche sur la fiche
  inspectorName     String?
  verdict           String?
  priceFromEur      Int?
  tripDuration      String?
  partnerBadge      String?
  locationLabel     String?

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@map("michelin_reviews")
}

model Bookmark {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, restaurantId])
  @@index([restaurantId])
  @@map("bookmarks")
}

model Favorite {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, restaurantId])
  @@index([restaurantId])
  @@map("favorites")
}

model PaymentCard {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand     CardBrand
  last4     String
  holder    String
  expMonth  Int
  expYear   Int
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("payment_cards")
}

model Reservation {
  id              String                    @id @default(cuid())
  userId          String
  user            User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurantId    String
  restaurant      Restaurant                @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  checkIn         DateTime
  checkOut        DateTime
  nights          Int
  adults          Int
  children        Int                       @default(0)

  roomId          String?
  roomName        String?
  roomCategory    String?

  eventType       ReservationEventType?
  customRequest   String?

  invitedFriends  Json?
  michelinExtras  Json?

  paymentMethod   ReservationPaymentMethod
  cardLast4       String?
  totalAmount     Int
  pricePerPerson  Int

  status          ReservationStatus         @default(CONFIRMED)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([userId])
  @@index([restaurantId])
  @@map("reservations")

}
model Accommodation {
  id            String                @id @default(cuid())
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  name          String
  description   String
  address       String
  category      AccommodationCategory
  stars         Int?
  priceFromEur  Int?
  mainImageUrl  String?
  videoUrl      String?
  video360      Boolean               @default(false)
  amenities     String[]              @default([])
  photos        String[]              @default([])

  owner         User                  @relation(fields: [ownerId], references: [id])
  ownerId       String

  @@index([ownerId])
  @@map("accommodations")
}

model Article {
  id           String     @id @default(cuid())
  title        String
  content      String
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String
  author       User       @relation(fields: [authorId], references: [id])
  authorId     String

  @@map("articles")
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  requester   User             @relation("FriendshipsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User             @relation("FriendshipsReceived", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
  @@index([requesterId])
  @@map("friendships")
}