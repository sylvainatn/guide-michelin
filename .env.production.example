# Remplir et renommer en `.env.production` sur le VPS (jamais committer).
# Utilisé par `docker compose -f docker-compose.prod.yml --env-file .env.production up -d`.

# ---- Image Docker ----
# Poussée par GitHub Actions sur GHCR. Remplacer <owner> par ton user/org GitHub.
GITHHUB_OWNER=sylvainatn
APP_IMAGE=ghcr.io/${GITHHUB_OWNER}/guide-michelin:latest


# ---- Postgres ----
POSTGRES_USER=michelin
POSTGRES_PASSWORD=michelin
POSTGRES_DB=michelin

# ---- Public URL ----
# Sans domaine : http://<IP_DU_VPS>:3000
# Avec domaine + reverse proxy : https://ton-domaine.tld
WEB_ORIGIN=http://142.93.73.60:3000
# `true` uniquement si tu as un reverse proxy HTTPS devant (domaine + TLS).
# Laisser `false` tant que tu tapes http://<ip>:3000 dans le navigateur.
COOKIE_SECURE=false

# ---- JWT (générer : openssl rand -base64 48) ----
JWT_ACCESS_SECRET=replace-with-48+chars
JWT_REFRESH_SECRET=replace-with-48+chars
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
